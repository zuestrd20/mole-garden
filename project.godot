; Mole Garden — original Godot 4 game
config_version=5
[application]
config/name="Mole Garden・地鼠小花園"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/mole.png"
[display]
window/size/viewport_width=1120
window/size/viewport_height=800
window/size/window_width_override=1120
window/size/window_height_override=800
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.082,0.176,0.157,1)
[input_devices]
pointing/emulate_mouse_from_touch=false
